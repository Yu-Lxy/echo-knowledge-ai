# Echo Knowledge AI — 环境变量样例
# 复制为 .env 后填写；密钥只能来自受控配置，不得硬编码或提交

# ---------- 数据库 ----------
POSTGRES_USER=echo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=echo
# backend/worker 内部连接串（compose 网络内）
DATABASE_URL=postgresql+psycopg://echo:change-me@db:5432/echo

# ---------- 应用 ----------
APP_DEBUG=false

# ---------- 本地存储（compose 内默认 /data/storage，指向 filestore 卷）----------
STORAGE_ROOT=/data/storage

# ---------- 模型服务（T1 待确认；M5 前无需填写，M0–M4 使用 fake 适配器）----------
# LLM_CHAT_BASE_URL=
# LLM_CHAT_API_KEY=
# LLM_CHAT_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=

# ---------- RAG 集中配置（ARCHITECTURE.md §5，默认值见文档；禁止硬编码）----------
# RAG_RECALL_TOP=10
# RAG_INJECT_TOP=5
# RAG_RERANK_THRESHOLD=0.60
# CHAT_HISTORY_ROUNDS=3
# QUESTION_MAX_CHARS=2000

# ---------- 上传限制（PRD D9）----------
# UPLOAD_MAX_FILES=10
# UPLOAD_MAX_PDF_MB=50
# UPLOAD_MAX_TXT_MD_MB=5

# ---------- 限流与配额（部署决定，PRD 6.7）----------
# RATE_LIMIT_UPLOAD_PER_MIN=
# RATE_LIMIT_CHAT_PER_MIN=
# RATE_LIMIT_REINDEX_PER_MIN=
# TOKEN_QUOTA_SOFT=
# TOKEN_QUOTA_HARD=
